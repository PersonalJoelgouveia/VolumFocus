// ============================================================================
// Etapas 1+2 — ownerUUID. Cole DENTRO do `match /databases/{database}/documents { ... }`
// das suas rules atuais. NÃO substitui nem altera nenhuma regra existente.
// Etapa 1: coleções userOwners/ownerUUIDs (vínculo). Etapa 2: helpers isMyOwnerUUID()/owned*()
// — a identidade confiável é request.auth.uid; o ownerUUID vindo do cliente (payload ou path)
// só é aceito se for IGUAL ao registrado em userOwners/{request.auth.uid}.
// ============================================================================

// ---- helpers (se já tiver um isPT()/alunoCadastrado() equivalente, reaproveite) ----
function ownerIsPT() {
  return request.auth.token.email_verified == true
    && request.auth.token.email.lower() in ['joelgouveia16@gmail.com', 'personaljoelgouveia@gmail.com'];
}
function ownerIsAlunoCadastrado() {
  return request.auth.token.email_verified == true
    && exists(/databases/$(database)/documents/alunos/$(request.auth.token.email.lower()));
}
function ownerUuidOk(id) {
  return id is string
    && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$');
}

// ---- ETAPA 2: camada de verificação (só funções; nenhuma coleção existente usa ainda) ----
// O servidor lê o vínculo do PRÓPRIO usuário autenticado e compara. Nunca confia em
// ownerUUID/ownerId/email/role enviados pelo React. Falha FECHADO: sem vínculo, sem
// campo ou campo de outro tipo => nega (get()/campo ausente gera erro => regra falha).
function hasOwnerLink() {
  return request.auth != null
    && exists(/databases/$(database)/documents/userOwners/$(request.auth.uid));
}
function myOwnerUUID() {
  return get(/databases/$(database)/documents/userOwners/$(request.auth.uid)).data.ownerUUID;
}
// "este ownerUUID (vindo de path ou payload) é MEU?"
function isMyOwnerUUID(id) {
  return hasOwnerLink() && id is string && id == myOwnerUUID();
}
// Para docs que carregam o campo `ownerUUID` no payload:
function ownedCreate() { return isMyOwnerUUID(request.resource.data.ownerUUID); }
function ownedRead()   { return isMyOwnerUUID(resource.data.ownerUUID); }
function ownedUpdate() {
  return isMyOwnerUUID(resource.data.ownerUUID)                           // já é meu
    && request.resource.data.ownerUUID == resource.data.ownerUUID;        // e não pode trocar
}
// TEMPLATES (etapa 3 — NÃO ativados). Path-based é o mais forte (o dono vai no caminho):
//   match /ownerData/{ownerUUID}/{document=**} { allow read, write: if isMyOwnerUUID(ownerUUID); }
// Payload-based, numa coleção existente:
//   allow create: if ownedCreate() && <regras atuais>;
//   allow read, delete: if ownedRead();
//   allow update: if ownedUpdate() && <regras atuais>;

// Vínculo Auth UID -> ownerUUID. Leitura só do próprio uid; create-only (imutável).
match /userOwners/{uid} {
  allow get: if request.auth != null && request.auth.uid == uid;
  allow list: if false;
  allow create: if request.auth != null
    && request.auth.uid == uid
    && (ownerIsPT() || ownerIsAlunoCadastrado())
    && request.resource.data.keys().hasOnly(['ownerUUID', 'createdAt'])
    && ownerUuidOk(request.resource.data.ownerUUID)
    && request.resource.data.createdAt == request.time
    // o índice reverso precisa nascer na MESMA transação/batch, apontando pra este uid
    && existsAfter(/databases/$(database)/documents/ownerUUIDs/$(request.resource.data.ownerUUID))
    && getAfter(/databases/$(database)/documents/ownerUUIDs/$(request.resource.data.ownerUUID)).data.uid == uid;
  allow update, delete: if false;
}

// Índice reverso: o ID do documento é o próprio UUID => dois uids nunca partilham um UUID.
match /ownerUUIDs/{ownerUUID} {
  allow get: if request.auth != null && resource.data.uid == request.auth.uid;
  allow list: if false;
  allow create: if request.auth != null
    && ownerUuidOk(ownerUUID)
    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/userOwners/$(request.auth.uid)).data.ownerUUID == ownerUUID;
  allow update, delete: if false;
}
